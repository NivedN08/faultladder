<mujoco model="reacher">
  <!-- A planar two-link arm seen from above: no gravity, no contacts. -->
  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 0" integrator="implicitfast">
    <flag contact="disable"/>
  </option>

  <default>
    <joint type="hinge" axis="0 0 1" armature="0.0002"/>
    <geom type="capsule" size="0.01" contype="0" conaffinity="0" density="1000"/>
    <position kp="0.5" kv="0.05"/>
  </default>

  <worldbody>
    <light pos="0 0 1"/>
    <body name="upper_arm">
      <joint name="shoulder"/>
      <geom name="upper_arm" fromto="0 0 0 0.1 0 0" rgba="0.3 0.5 0.8 1"/>
      <body name="forearm" pos="0.1 0 0">
        <joint name="elbow" limited="true" range="-2.7 2.7"/>
        <geom name="forearm" fromto="0 0 0 0.1 0 0" rgba="0.3 0.7 0.5 1"/>
        <site name="fingertip" pos="0.1 0 0" size="0.012" rgba="0.9 0.8 0.1 1"/>
      </body>
    </body>
    <body name="target" mocap="true" pos="0.15 0 0">
      <site name="target" size="0.02" rgba="0.9 0.2 0.2 0.5"/>
    </body>
  </worldbody>

  <actuator>
    <position name="shoulder" joint="shoulder"/>
    <position name="elbow" joint="elbow"/>
  </actuator>
</mujoco>
